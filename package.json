{
  "name": "rajatxsosapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm run api:dev\" \"NEXT_PUBLIC_API_PORT=${API_PORT:-4000} next dev -p ${WEB_PORT:-3000}\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:dev": "tsx watch server/main.ts",
    "api:start": "tsx server/main.ts",
    "api:build": "esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/main.mjs",
    "db:setup": "tsx server/scripts/db.ts setup",
    "db:reset": "tsx server/scripts/db.ts reset",
    "db:status": "tsx server/scripts/db.ts status",
    "test:api": "node server/tests/api-e2e.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.5",
    "immer": "^11.1.21",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
